# Copy this file to .env.local (or set these on Vercel) and fill in the values.
# ./infra/up.sh prints the first two after a deploy.

# Server-side only (never sent to the browser): the control-plane API Gateway URL,
# the `control_plane_api_url` Terraform output.
CONTROL_PLANE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Public: the interview WebSocket base. Local orchestrator: ws://localhost:8000.
# Deployed: the `orchestrator_ws_url` Terraform output (wss://xxxx.cloudfront.net).
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8000

# Public: base URL of this app, used to build shareable invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

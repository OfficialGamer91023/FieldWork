# Copy this file to .env.local and fill in the values.

# Server-side only (never exposed to the browser). The control-plane API
# Gateway invoke URL — the `control_plane_api_url` Terraform output.
CONTROL_PLANE_API_URL=https://ppqt2h4fyi.execute-api.us-east-1.amazonaws.com

# Public (shipped to the browser). The orchestrator WebSocket base URL.
# Local dev: your FastAPI server. On AWS: ws://<alb_dns_name>
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8000

# Public. Base URL of THIS app, used to render shareable invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
